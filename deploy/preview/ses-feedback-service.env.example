# All flags default off. No import/load starts HTTP, SMTP, migrations or AWS work.
WP_ENV=test
WP_ENABLE_SES_FEEDBACK_SERVICE=0
WP_ENABLE_SES_FEEDBACK_CONFIG=0
WP_SES_FEEDBACK_CONFIG_FILE=/var/lib/wiejskapaka/ses-feedback-pins.json
WP_ENABLE_SES_REVIEW_KEYS=0
WP_SES_REVIEW_KEYS_FILE=/var/lib/wiejskapaka/ses-review-keys.json
WP_ENABLE_SES_FEEDBACK_DATABASE=0
WP_SES_FEEDBACK_DATABASE_FILE=/var/lib/wiejskapaka/ses-feedback-database.json
WP_SES_REVIEW_MAX_RECORDS=1000
WP_SES_REVIEW_RETENTION_SECONDS=604800
WP_SES_FEEDBACK_BODY_TIMEOUT=5
WP_SES_FEEDBACK_MAX_INFLIGHT=8
