# PREPARATION ONLY. No HTTP hook or daemon invokes purchase mail yet.
# Keep disabled until account email ownership verification and queue wiring exist.
WP_ENABLE_ORDER_SMTP=0
WP_SES_REGION=eu-north-1
WP_SES_DOMAIN=wiejskapaka.pl
WP_SMTP_HOST=email-smtp.eu-north-1.amazonaws.com
WP_SMTP_MODE=starttls
WP_SMTP_PORT=587
WP_SMTP_TIMEOUT=10
WP_SMTP_USERNAME=REPLACE_WITH_SES_SMTP_USERNAME_PRIVATELY
WP_SMTP_PASSWORD_FILE=/var/lib/wiejskapaka/ses-smtp-password
WP_SMTP_FROM=noreply@wiejskapaka.pl
WP_PUBLIC_ORIGIN=https://wiejskapaka.pl
# The SMTP password is a separate private file outside the repository (0600).
# Do not use your AWS console password or general AWS root/API access keys.
