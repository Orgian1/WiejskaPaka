# TEMPLATE ONLY. Replace password privately before installation.
# Install as /etc/wiejskapaka/preview.env, owner root, mode 0600.
WP_ENV=test
WP_REAL_PAYMENTS=0
WP_ENABLE_TEST_PAYMENTS=0
WP_BIND_HOST=127.0.0.1
WP_PORT=8000
WP_TEST_DATABASE_URL=postgresql://wp_preview_app:REPLACE_ME@127.0.0.1:5432/wp_test_preview
WP_CHECKOUT_KEY_FILE=/var/lib/wiejskapaka/checkout-key.json
# Optional marketplace features; leave disabled until the corresponding reviewed
# PostgreSQL migrations are installed in the disposable preview database.
WP_ENABLE_PRODUCT_UNITS=0
WP_ENABLE_ADDRESS_DELIVERY=0
WP_ENABLE_USER_PHOTOS=0
WP_ENABLE_SELLER_SEARCH=0
# Requires private external queue keys and optional_email_verification.sql.
WP_ENABLE_EMAIL_VERIFICATION=0
WP_ENABLE_ORDER_MAIL_QUEUE=0
# To exercise the shared-cart checkout in a closed test preview only, enable
# WP_ENABLE_TEST_PAYMENTS=1 above. This does not enable real payments.
# Leave DATABASE_URL, WIEJSKAPAKA_DB and WP_AUTO_INIT_POSTGRES unset.
# No PSP, SMTP or production credentials in this file or repository.

# Require confirmed current account email before direct/cart purchases.
# Enable only together with WP_ENABLE_EMAIL_VERIFICATION=1 and its protected keys.
WP_REQUIRE_VERIFIED_EMAIL_FOR_CHECKOUT=0

# Persistent private preview only; isolated from order settlement and bank transfers.
WP_ENABLE_WALLET_PREVIEW=0
