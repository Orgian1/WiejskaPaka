# Loading an existing key snapshot does not start an SNS listener or a worker.
# Provision independent AES-256 keys privately; never paste them into git/chat.
# External POSIX regular file, service UID owner, no group/other access (e.g. 0600).
WP_ENABLE_SES_REVIEW_KEYS=0
WP_SES_REVIEW_KEYS_FILE=/var/lib/wiejskapaka/ses-review-keys.json
