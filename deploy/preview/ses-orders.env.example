# TEMPLATE ONLY. Verification delivery and checkout capture have separate opt-ins.
# Purchase SMTP still requires a separate bounded worker; no daemon is started.
WP_ENABLE_ORDER_SMTP=0
WP_SES_REGION=eu-north-1
WP_SES_DOMAIN=wiejskapaka.pl
WP_SMTP_HOST=email-smtp.eu-north-1.amazonaws.com
WP_SMTP_MODE=starttls
WP_SMTP_PORT=587
WP_SMTP_TIMEOUT=10
WP_SMTP_USERNAME=REPLACE_WITH_SES_SMTP_USERNAME_PRIVATELY
WP_SMTP_PASSWORD_FILE=/var/lib/wiejskapaka/ses-smtp-password
WP_SMTP_FROM=noreply@wiejskapaka.pl
WP_PUBLIC_ORIGIN=https://wiejskapaka.pl
# The SMTP password is a separate private file outside the repository (0600).
# Do not use your AWS console password or general AWS root/API access keys.

# Verification HTTP/UI and encrypted queue remain disabled until separately configured.
WP_ENABLE_EMAIL_VERIFICATION=0
# WP_ENABLE_MAIL_QUEUE=1
# WP_MAIL_QUEUE_KEYS_FILE=/var/lib/wiejskapaka/mail-queue-keys.json

# Separate explicit opt-ins; neither starts a daemon.
WP_ENABLE_VERIFICATION_SMTP=0
WP_ENABLE_ORDER_MAIL_QUEUE=0

# REQUIRED before either --send command. Set from confirmed SES account limits.
# Both commands must use identical values; no implicit defaults or live policy changes.
# WP_MAIL_MIN_INTERVAL_SECONDS=REPLACE_WITH_POSITIVE_INTEGER
# WP_MAIL_DAILY_LIMIT=REPLACE_WITH_CONFIRMED_DAILY_LIMIT
