# PREPARATION ONLY: no HTTP route or worker invokes the adapter yet.
# Keep disabled. These settings alone do not enable application mail.
WP_ENABLE_SMTP=0
WP_SMTP_HOST=smtp.example.invalid
WP_SMTP_MODE=starttls
WP_SMTP_PORT=587
WP_SMTP_TIMEOUT=10
WP_SMTP_USERNAME=REPLACE_PRIVATELY
WP_SMTP_PASSWORD_FILE=/var/lib/wiejskapaka/smtp-password
WP_SMTP_FROM=noreply@example.invalid
WP_PUBLIC_ORIGIN=https://example.invalid
